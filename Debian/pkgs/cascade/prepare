#!/usr/bin/env bash
# Vendor the Rust dependencies into a "vendor" component tarball, so that the
# source package carries every crate it needs. debcraft builds with
# --network=none, and cascade depends on crates from git, so nothing can be
# fetched at build time.
set -euo pipefail

tree="$1"
prefix="$2"

cargo vendor --locked --manifest-path "$tree/Cargo.toml" "$tree/vendor" > /dev/null
tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner \
    -czf "$prefix.orig-vendor.tar.gz" -C "$tree" vendor
